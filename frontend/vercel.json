{
  "cleanUrls": true,
  "redirects": [
    { "source": "/landing/v1", "destination": "/", "permanent": false },
    { "source": "/landing/v1/", "destination": "/", "permanent": false },
    { "source": "/landing/v1/index.html", "destination": "/", "permanent": false },
    { "source": "/login", "destination": "/entrar", "permanent": false },
    { "source": "/login.html", "destination": "/entrar", "permanent": false },
    { "source": "/cadastro", "destination": "/criar-conta", "permanent": false },
    { "source": "/cadastro.html", "destination": "/criar-conta", "permanent": false },
    { "source": "/redefinir-senha", "destination": "/nova-senha", "permanent": false },
    { "source": "/redefinir-senha.html", "destination": "/nova-senha", "permanent": false },
    { "source": "/onboarding", "destination": "/primeiros-passos", "permanent": false },
    { "source": "/onboarding.html", "destination": "/primeiros-passos", "permanent": false },
    { "source": "/consentimento", "destination": "/autorizacao", "permanent": false },
    { "source": "/consentimento.html", "destination": "/autorizacao", "permanent": false },
    { "source": "/estado", "destination": "/seu-estado", "permanent": false },
    { "source": "/estado.html", "destination": "/seu-estado", "permanent": false },
    { "source": "/dashboard", "destination": "/minha-dieta", "permanent": false },
    { "source": "/dashboard.html", "destination": "/minha-dieta", "permanent": false },
    { "source": "/compras", "destination": "/lista-de-compras", "permanent": false },
    { "source": "/compras.html", "destination": "/lista-de-compras", "permanent": false },
    { "source": "/casa-convite", "destination": "/convite", "permanent": false },
    { "source": "/casa-convite.html", "destination": "/convite", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self' https://ronu-api-dwcbcwgqgzgdhhag.chilecentral-01.azurewebsites.net https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
